# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL ---
# These credentials match docker-compose.yml exactly — if you ran
# `docker compose up -d` as described in the README, this works as-is.
DATABASE_URL="postgresql://reco_user:reco_pass@localhost:5432/reco_db?schema=public"

# --- Redis (cache + BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Worker tuning ---
RECO_WORKER_CONCURRENCY=5
